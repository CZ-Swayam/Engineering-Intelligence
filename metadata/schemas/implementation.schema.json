{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-intelligence.dev/schemas/implementation.schema.json",
  "title": "Component Implementation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "language",
    "framework",
    "runtime",
    "dependencies",
    "supported_capabilities",
    "distribution",
    "maturity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "language": {
      "type": "string"
    },
    "framework": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "distribution": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "maturity": {
      "type": "string",
      "enum": [
        "experimental",
        "beta",
        "stable",
        "deprecated"
      ]
    },
    "tested": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
