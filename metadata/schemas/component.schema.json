{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-intelligence.dev/schemas/component.schema.json",
  "title": "Engineering Component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "domain",
    "tags",
    "capabilities",
    "implementations",
    "maturity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "domain": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "framework",
          "path",
          "manifest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
          },
          "language": {
            "type": "string"
          },
          "framework": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "manifest": {
            "type": "string"
          },
          "distribution": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "default": [
              "source"
            ]
          }
        }
      }
    },
    "maturity": {
      "type": "string",
      "enum": [
        "experimental",
        "beta",
        "stable",
        "deprecated"
      ]
    },
    "related_knowledge": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    }
  }
}